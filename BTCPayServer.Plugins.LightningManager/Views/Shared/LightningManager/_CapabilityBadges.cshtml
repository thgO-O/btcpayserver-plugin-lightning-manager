@model LightningCapabilities

@{
    var items = new[]
    {
        ("Info", Model.CanGetInfo),
        ("Balance", Model.CanGetBalance),
        ("Pay BOLT11", Model.CanPayBolt11),
        ("Amountless BOLT11", Model.CanPayAmountless),
        ("Set Max Fee", Model.CanSetMaxFee),
        ("Connect Peer", Model.CanConnectPeer),
        ("Open Channel", Model.CanOpenChannel),
        ("List Channels", Model.CanListChannels)
    };
}

<div class="d-flex flex-wrap gap-2">
    @foreach (var item in items)
    {
        <span class="badge @(item.Item2 ? "bg-success" : "bg-secondary")">
            <span aria-hidden="true">@(item.Item2 ? "✓" : "×")</span>
            @item.Item1<span class="visually-hidden"> @(item.Item2 ? "available" : "unavailable")</span>
        </span>
    }
</div>
