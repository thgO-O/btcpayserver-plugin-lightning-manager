@model LightningManagerPageViewModel
@if (Model.IsConfigured)
{
    <div class="alert alert-info mb-4">
        @if (Model.Capabilities.CanGetDepositAddress)
        {
            <p>Opening a channel requires confirmed bitcoin in this node's on-chain wallet, plus funds for transaction fees. Your store's Bitcoin wallet balance is separate.</p>
            <a class="btn btn-primary" asp-controller="LightningManager" asp-action="Fund" asp-route-storeId="@Model.StoreId" asp-route-cryptoCode="@Model.CryptoCode">Add funds to node</a>
        }
        else
        {
            <span>To add funds, use your Lightning wallet or provider's deposit tools. This backend does not expose an on-chain deposit address through Lightning Manager.</span>
        }
    </div>
}
