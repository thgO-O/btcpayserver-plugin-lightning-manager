@using BTCPayServer
@using BTCPayServer.Abstractions.Contracts
@inject IScopeProvider ScopeProvider
@inject IStoreLightningManagerContextFactory ContextFactory
@{
    var storeId = ScopeProvider.GetCurrentStoreId();
    var cryptoCode = ViewContext.RouteData.Values["cryptoCode"] as string;
    var store = Context.GetStoreDataOrNull();
    if (string.IsNullOrEmpty(storeId) ||
        string.IsNullOrEmpty(cryptoCode) ||
        store is null ||
        !LightningManagerCrypto.IsSupported(cryptoCode))
    {
        return;
    }

    var managerContext = await ContextFactory.CreateAsync(store, cryptoCode);
}

@if (!managerContext.IsInternalNode)
{
    <li class="nav-item nav-item-sub">
        <a layout-menu-item="@LightningManagerNavPages.Overview"
           asp-controller="LightningManager"
           asp-action="Overview"
           asp-route-storeId="@storeId"
           asp-route-cryptoCode="@cryptoCode">
            Overview
        </a>
    </li>
}

@if (managerContext.IsInternalNode)
{
    <li class="nav-item nav-item-sub">
        <a layout-menu-item="@LightningManagerNavPages.StoreBalance"
           asp-controller="LightningManager"
           asp-action="StoreBalance"
           asp-route-storeId="@storeId"
           asp-route-cryptoCode="@cryptoCode">
            Pay
        </a>
    </li>
    <li class="nav-item nav-item-sub">
        <a layout-menu-item="@LightningManagerNavPages.History"
           asp-controller="LightningManager"
           asp-action="History"
           asp-route-storeId="@storeId"
           asp-route-cryptoCode="@cryptoCode">
            History
        </a>
    </li>
}

@if (!managerContext.IsInternalNode && managerContext.Capabilities.CanPayBolt11)
{
    <li class="nav-item nav-item-sub">
        <a layout-menu-item="@LightningManagerNavPages.Send"
           asp-controller="LightningManager"
           asp-action="Send"
           asp-route-storeId="@storeId"
           asp-route-cryptoCode="@cryptoCode">
            Send
        </a>
    </li>
}

@if (!managerContext.IsInternalNode && managerContext.Capabilities.CanConnectPeer)
{
    <li class="nav-item nav-item-sub">
        <a layout-menu-item="@LightningManagerNavPages.Peers"
           asp-controller="LightningManager"
           asp-action="Peers"
           asp-route-storeId="@storeId"
           asp-route-cryptoCode="@cryptoCode">
            Peers
        </a>
    </li>
}

@if (!managerContext.IsInternalNode && (managerContext.Capabilities.CanListChannels || managerContext.Capabilities.CanOpenChannel))
{
    <li class="nav-item nav-item-sub">
        <a layout-menu-item="@LightningManagerNavPages.Channels"
           asp-controller="LightningManager"
           asp-action="Channels"
           asp-route-storeId="@storeId"
           asp-route-cryptoCode="@cryptoCode">
            Channels
        </a>
    </li>
}
