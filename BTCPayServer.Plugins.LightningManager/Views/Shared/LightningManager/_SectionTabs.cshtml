@model LightningManagerTabsViewModel

<ul class="nav nav-tabs mb-4">
    @if (Model.ShowOverview)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.ActivePage == LightningManagerNavPages.Overview ? "active" : "")"
               aria-current="@(Model.ActivePage == LightningManagerNavPages.Overview ? "page" : null)"
               asp-controller="LightningManager"
               asp-action="Overview"
               asp-route-storeId="@Model.StoreId"
               asp-route-cryptoCode="@Model.CryptoCode">
                Overview
            </a>
        </li>
    }
    @if (Model.ShowSend)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.ActivePage == LightningManagerNavPages.Send ? "active" : "")"
               aria-current="@(Model.ActivePage == LightningManagerNavPages.Send ? "page" : null)"
               asp-controller="LightningManager"
               asp-action="Send"
               asp-route-storeId="@Model.StoreId"
               asp-route-cryptoCode="@Model.CryptoCode">
                Pay
            </a>
        </li>
    }
    @if (Model.ShowPeers)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.ActivePage == LightningManagerNavPages.Peers ? "active" : "")"
               aria-current="@(Model.ActivePage == LightningManagerNavPages.Peers ? "page" : null)"
               asp-controller="LightningManager"
               asp-action="Peers"
               asp-route-storeId="@Model.StoreId"
               asp-route-cryptoCode="@Model.CryptoCode">
                Peers
            </a>
        </li>
    }
    @if (Model.ShowChannels)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.ActivePage == LightningManagerNavPages.Channels ? "active" : "")"
               aria-current="@(Model.ActivePage == LightningManagerNavPages.Channels ? "page" : null)"
               asp-controller="LightningManager"
               asp-action="Channels"
               asp-route-storeId="@Model.StoreId"
               asp-route-cryptoCode="@Model.CryptoCode">
                Channels
            </a>
        </li>
    }
</ul>
