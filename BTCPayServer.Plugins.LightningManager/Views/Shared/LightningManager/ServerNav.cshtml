@model BTCPayServer.Components.MainNav.MainNavViewModel
@using BTCPayServer.Client
@{
    var activePage = ViewData["ActivePage"]?.ToString();
    var selectedCryptoCode = ViewData["SelectedCryptoCode"]?.ToString();
    var showLightningManagerSubItems =
        activePage == LightningManagerNavPages.Server ||
        activePage == LightningManagerNavPages.ServerSend ||
        activePage == LightningManagerNavPages.ServerPeers ||
        activePage == LightningManagerNavPages.ServerChannels;
}

<li class="nav-item nav-item-sub" permission="@Policies.CanModifyServerSettings">
    <a asp-controller="ServerLightningManager"
       asp-action="Index"
       asp-route-cryptoCode="@selectedCryptoCode"
       layout-menu-item="@LightningManagerNavPages.Server">
        Lightning Manager
    </a>
</li>
@if (showLightningManagerSubItems)
{
    <li class="nav-item nav-item-sub ps-5" permission="@Policies.CanModifyServerSettings">
        <a asp-controller="ServerLightningManager"
           asp-action="Send"
           asp-route-cryptoCode="@selectedCryptoCode"
           layout-menu-item="@LightningManagerNavPages.ServerSend">
            Send
        </a>
    </li>
    <li class="nav-item nav-item-sub ps-5" permission="@Policies.CanModifyServerSettings">
        <a asp-controller="ServerLightningManager"
           asp-action="Peers"
           asp-route-cryptoCode="@selectedCryptoCode"
           layout-menu-item="@LightningManagerNavPages.ServerPeers">
            Peers
        </a>
    </li>
    <li class="nav-item nav-item-sub ps-5" permission="@Policies.CanModifyServerSettings">
        <a asp-controller="ServerLightningManager"
           asp-action="Channels"
           asp-route-cryptoCode="@selectedCryptoCode"
           layout-menu-item="@LightningManagerNavPages.ServerChannels">
            Channels
        </a>
    </li>
}
