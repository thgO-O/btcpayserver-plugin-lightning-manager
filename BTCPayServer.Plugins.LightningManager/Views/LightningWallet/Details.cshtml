@using System.Globalization
@model BTCPayServer.Plugins.LightningManager.Wallet.WalletPageModel
@{
    Layout = "_LayoutWallet"; var op = Model.Operation!;
    var incoming = op.Direction == "Incoming";
    ViewData["WalletPage"] = incoming ? "Receive" : "Send";
    var awaitingPayment = incoming && !op.IsFinal;
}
@section PageHeadContent {
    <link href="~/main/qrcode.css" rel="stylesheet" asp-append-version="true" />
}
<div class="ln-wallet__page-heading"><h1>@(incoming ? "Invoice" : "Payment")</h1></div>
<div class="ln-wallet__form-grid">
    <section class="ln-wallet__card ln-wallet__form-card ln-wallet__receipt">
        <span class="ln-wallet__receipt-icon @(op.State == "Settled" ? "is-success" : "")" aria-hidden="true"><vc:icon symbol="@(op.State == "Settled" ? "checkmark" : incoming ? "payment-receive" : "payment-send")" /></span>
        @if (op.DisplayAmountMsat is long amount)
        {
            <p class="ln-wallet__receipt-amount" data-operation-amount>@((amount / 1000m).ToString("#,0.###", CultureInfo.InvariantCulture)) <small>sats</small></p>
        }
        else
        {
            <p class="ln-wallet__receipt-amount ln-wallet__receipt-unavailable" data-operation-amount>@(incoming ? "Received amount unavailable" : "Paid amount unavailable")</p>
        }
        <span class="ln-wallet__fiat" data-fiat-sats="@((op.DisplayAmountMsat / 1000m)?.ToString(CultureInfo.InvariantCulture))" hidden></span>
        <p class="ln-wallet__receipt-description">@(string.IsNullOrEmpty(op.Description) ? (incoming ? "Lightning invoice" : "Lightning payment") : op.Description)</p>
        <p class="ln-wallet__status" role="status" data-state="@op.State" data-status-url="@Url.Action("Status", "LightningWallet", new { storeId = Model.StoreId, id = op.Id })" data-final="@((op.IsFinal && !op.RequiresReconciliation).ToString().ToLowerInvariant())">@op.State</p>
        <p class="ln-wallet__status-error ln-wallet__inline-error" role="status"></p>
        @if (!incoming)
        {
            <div class="ln-wallet__notice ln-wallet__notice-warning" data-payment-failure hidden="@(op.State != "Failed")" role="status" aria-live="polite">
                <span class="ln-wallet__notice-icon" aria-hidden="true"><vc:icon symbol="warning" /></span>
                <div><strong>Payment failed</strong><p data-failure-message>@op.FailureMessage</p><p class="mt-2">Use the payment hash in Payment details to inspect it on your node. It is never retried automatically.</p></div>
            </div>
            @if (op.State != "Settled")
            {
                <div class="ln-wallet__notice ln-wallet__notice-warning"><span class="ln-wallet__notice-icon" aria-hidden="true"><vc:icon symbol="warning" /></span><p>Check this payment or your node before paying again. It is never resent automatically.</p></div>
            }
        }
        @if (op.State == "Settled" && op.SettledAmountMsat != op.AmountMsat)
        {
            <div class="ln-wallet__notice ln-wallet__notice-warning"><span class="ln-wallet__notice-icon" aria-hidden="true"><vc:icon symbol="warning" /></span><p>The @(incoming ? "requested" : "reviewed") amount was @((op.AmountMsat / 1000m).ToString("#,0.###", CultureInfo.InvariantCulture)) sats.
                @if (incoming)
                {
                    @(op.SettledAmountMsat is null ? "The node's received amount has not been retrieved yet." : "The sender paid a different amount.")
                }
                else
                {
                    @(op.SettledAmountMsat is null ? "The node's paid amount has not been retrieved yet." : "The node reports a different paid amount. This invoice may have been paid through another interface.")
                }
            </p></div>
        }
        @if (awaitingPayment)
        {
            <div class="ln-wallet__qr"><vc:qr-code data="@("lightning:" + op.Bolt11)" /></div>
            <button type="button" class="btn btn-primary w-100" data-clipboard-target="#wallet-invoice"><span aria-hidden="true"><vc:icon symbol="actions-copy" /></span>Copy invoice</button>
            <p id="wallet-invoice" class="ln-wallet__invoice font-monospace" tabindex="0" aria-label="Lightning invoice">@op.Bolt11</p>
            <p class="ln-wallet__help">Expires <time datetime="@op.ExpiresAt?.ToString("O")" data-local-time>@op.ExpiresAt?.ToString("u")</time>. This page updates when paid; your node can still receive after you close it.</p>
        }
        @if (op.FeeMsat is long fee)
        {
            <div class="ln-wallet__receipt-fee">Routing fee: @((fee / 1000m).ToString("0.###", CultureInfo.InvariantCulture)) sats<span class="ln-wallet__fiat" data-fiat-sats="@((fee / 1000m).ToString(CultureInfo.InvariantCulture))" hidden></span></div>
        }
        <details class="ln-wallet__details"><summary>Payment details</summary><dl class="ln-wallet__review"><div><dt>Payment hash</dt><dd class="font-monospace text-break">@op.PaymentHash</dd></div><div><dt>Created</dt><dd><time datetime="@op.CreatedAt.ToString("O")" data-local-time>@op.CreatedAt.ToString("u")</time></dd></div></dl></details>
        @if (!awaitingPayment)
        {
            <a asp-controller="LightningWallet" asp-action="Home" asp-route-storeId="@Model.StoreId" class="btn btn-secondary w-100 mt-3">Back to wallet</a>
        }
    </section>
</div>
