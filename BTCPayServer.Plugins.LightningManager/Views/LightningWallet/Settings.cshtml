@model BTCPayServer.Plugins.LightningManager.Wallet.WalletPageModel
@{ Layout = "_LayoutWallet"; ViewData["WalletPage"] = "Settings"; }
<div class="ln-wallet__page-heading"><h1>Wallet Mode</h1><span class="ln-wallet__pill">@(Model.Enabled ? "Enabled" : "Disabled")</span></div>
<div class="ln-wallet__form-grid">
    <section class="ln-wallet__card ln-wallet__form-card">
        <form method="post" asp-controller="LightningWallet" asp-action="Settings" asp-route-storeId="@Model.StoreId">
            <div class="ln-wallet__setting-row">
                <label asp-for="Enabled"><strong>Enable Wallet Mode for this store</strong><span>Uses your connected LND or Core Lightning node.</span></label>
                <div class="form-check form-switch"><input asp-for="Enabled" class="form-check-input" role="switch" /></div>
            </div>
            <div class="ln-wallet__setting-info"><span aria-hidden="true"><vc:icon symbol="key" /></span><div><h2>Passkey for every payment</h2><p>Each operator confirms payments with their own passkey.</p></div></div>
            <div class="ln-wallet__setting-info"><span aria-hidden="true"><vc:icon symbol="wallet-wallet" /></span><div><h2>Shared funds</h2><p>Uses the node's shared funds; no individual balances. Manager and API permissions are unchanged.</p></div></div>
            <button class="btn btn-primary w-100" type="submit">Save</button>
        </form>
        <details class="ln-wallet__details"><summary>About Wallet Mode</summary><p>Disabling Wallet Mode keeps your history. Submitted payments continue to be checked with the node.</p></details>
    </section>
</div>
