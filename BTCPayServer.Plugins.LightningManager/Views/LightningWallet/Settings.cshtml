@model BTCPayServer.Plugins.LightningManager.Wallet.WalletPageModel
@{ Layout = "_LayoutWallet"; }
<h1 class="h3">Wallet Mode</h1>
<p>Use your connected LND or Core Lightning node from a mobile wallet interface. Operators keep their existing access to the node; this does not create individual balances.</p>
<p>Every payment in this interface requires a passkey. Other authorized Manager and API payment flows keep their existing authentication.</p>
<form method="post" asp-controller="LightningWallet" asp-action="Settings" asp-route-storeId="@Model.StoreId">
    <div class="form-check mb-4">
        <input asp-for="Enabled" class="form-check-input" />
        <label asp-for="Enabled" class="form-check-label">Enable Wallet Mode for this store</label>
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
</form>
