@model BTCPayServer.Plugins.LightningManager.Wallet.WalletPageModel
@{ Layout = "_LayoutWallet"; }
<h1 class="h3">Receive Lightning</h1>
<form method="post" asp-controller="LightningWallet" asp-action="Receive" asp-route-storeId="@Model.StoreId">
    <div class="form-group">
        <label for="amountSats" class="form-label">Amount in sats</label>
        <input id="amountSats" name="amountSats" type="number" min="1" step="1" required inputmode="numeric" class="form-control" />
    </div>
    <div class="form-group">
        <label for="description" class="form-label">Description (optional)</label>
        <input id="description" name="description" maxlength="200" class="form-control" />
    </div>
    <p class="text-secondary small">This invoice expires in one hour. The node must stay online and have inbound liquidity to receive.</p>
    <button class="btn btn-primary btn-lg w-100" type="submit">Create invoice</button>
</form>
