@model BTCPayServer.Plugins.LightningManager.Wallet.WalletPageModel
@{ Layout = "_LayoutWallet"; }
<h1 class="h3">History</h1>
<p class="text-secondary small">Latest 100 operations created through Wallet Mode for this store and node. Other node activity is not included.</p>
<div data-history-url="@Url.Action("HistoryData", "LightningWallet", new { storeId = Model.StoreId })" data-history-snapshot="@string.Join(";", Model.Operations.Select(x => $"{x.Id}:{x.State}"))">
    <partial name="_Operations" model="Model" />
</div>
<p data-history-error role="status" class="text-secondary"></p>
