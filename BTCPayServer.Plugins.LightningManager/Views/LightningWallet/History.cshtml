@model BTCPayServer.Plugins.LightningManager.Wallet.WalletPageModel
@{ Layout = "_LayoutWallet"; ViewData["WalletPage"] = "History"; }
<div class="ln-wallet__page-heading"><h1>History</h1></div>
<section class="ln-wallet__card ln-wallet__history" aria-label="Wallet operations" data-history-url="@Url.Action("HistoryData", "LightningWallet", new { storeId = Model.StoreId })" data-history-snapshot="@string.Join(";", Model.Operations.Select(x => $"{x.Id}:{x.State}:{x.SettledAmountMsat}"))">
    <partial name="_Operations" model="Model" />
</section>
<p data-history-error role="status" class="ln-wallet__inline-error"></p>
<p class="ln-wallet__help">Latest 100 operations for this store and connected node. Payments made elsewhere are not included.</p>
