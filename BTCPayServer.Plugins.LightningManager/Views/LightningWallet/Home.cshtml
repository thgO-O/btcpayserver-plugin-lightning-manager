@using System.Globalization
@model BTCPayServer.Plugins.LightningManager.Wallet.WalletPageModel
@{ Layout = "_LayoutWallet"; }
<section class="ln-wallet__balance" aria-label="Lightning balance" data-balance-url="@Url.Action("Balance", "LightningWallet", new { storeId = Model.StoreId })">
    <p class="text-secondary">Connected node balance</p>
    <strong hidden="@(Model.BalanceSats is null)"><span data-balance-amount>@Model.BalanceSats?.ToString("#,0.###", CultureInfo.InvariantCulture)</span> <small>sats</small></strong>
    <p role="status" data-balance-error hidden="@(Model.BalanceSats is not null)">@Model.BalanceError</p>
</section>
<p class="text-secondary small">These funds belong to the connected node and are shared with its authorized operators. Receiving also depends on inbound liquidity.</p>
@if (Model.IsInternal)
{
    <div class="alert alert-warning">This is the server's shared internal node. Funds are not isolated to this store.</div>
}
<div class="ln-wallet__actions">
    <a asp-controller="LightningWallet" asp-action="Send" asp-route-storeId="@Model.StoreId" class="btn btn-primary btn-lg">Pay</a>
    <a asp-controller="LightningWallet" asp-action="Receive" asp-route-storeId="@Model.StoreId" class="btn btn-secondary btn-lg">Receive</a>
</div>
<h1 class="h5">Recent activity</h1>
<partial name="_Operations" model="Model" />
