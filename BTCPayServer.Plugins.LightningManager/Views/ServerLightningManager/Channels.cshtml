@model ServerLightningManagerViewModel

<div class="sticky-header">
    <h2>Server Lightning Channels</h2>
</div>

<partial name="_StatusMessage" />
<partial name="_Result" model="Model.Result" />

@if (Model.InternalCryptoCodes.Count > 1)
{
    <form asp-controller="ServerLightningManager" asp-action="Channels" method="get" class="mb-4">
        <label class="form-label" for="serverCryptoCode">Internal node</label>
        <select class="form-select w-auto" id="serverCryptoCode" name="cryptoCode" onchange="this.form.submit()">
            @foreach (var cryptoCode in Model.InternalCryptoCodes)
            {
                <option value="@cryptoCode" selected="@(cryptoCode == Model.SelectedCryptoCode)">@cryptoCode</option>
            }
        </select>
    </form>
}

<div class="card">
    <div class="card-body">
        <h3 class="h5">Open Channel</h3>
        <form asp-controller="ServerLightningManager" asp-action="PreviewChannel" method="post" class="row g-3 align-items-end">
            <input type="hidden" name="cryptoCode" value="@Model.SelectedCryptoCode" />
            <div class="col-lg-5">
                <label class="form-label" for="serverChannelNodeUri">Node URI</label>
                <input class="form-control" id="serverChannelNodeUri" name="nodeUri" value="@Model.Channels.NodeUri" placeholder="pubkey@host:9735" />
            </div>
            <div class="col-md-4 col-lg-3">
                <label class="form-label" for="serverChannelAmountSats">Amount (sats)</label>
                <input class="form-control" id="serverChannelAmountSats" name="channelAmountSats" value="@Model.Channels.ChannelAmountSats" />
            </div>
            <div class="col-md-4 col-lg-2">
                <label class="form-label" for="serverFeeRateSatsPerByte">Fee rate</label>
                <input class="form-control" id="serverFeeRateSatsPerByte" name="feeRateSatsPerByte" value="@Model.Channels.FeeRateSatsPerByte" placeholder="1" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary" disabled="@(!Model.Channels.IsConfigured || !Model.Channels.Capabilities.CanOpenChannel)">Preview open</button>
            </div>
        </form>

        @if (Model.Channels.Preview is not null)
        {
            <div class="border rounded p-3 mt-4">
                <h3 class="h6">Confirm Channel Open</h3>
                <dl>
                    <dt>Peer</dt>
                    <dd><code>@Model.Channels.Preview.NodeUri</code></dd>
                    <dt>Amount</dt>
                    <dd>@Model.Channels.Preview.ChannelAmountDisplay</dd>
                    <dt>Fee rate</dt>
                    <dd>@Model.Channels.Preview.FeeRateDisplay</dd>
                </dl>
                <form asp-controller="ServerLightningManager" asp-action="OpenChannel" method="post">
                    <input type="hidden" name="cryptoCode" value="@Model.SelectedCryptoCode" />
                    <input type="hidden" name="nodeUri" value="@Model.Channels.NodeUri" />
                    <input type="hidden" name="channelAmountSats" value="@Model.Channels.ChannelAmountSats" />
                    <input type="hidden" name="feeRateSatsPerByte" value="@Model.Channels.FeeRateSatsPerByte" />
                    <button type="submit" class="btn btn-primary">Open channel</button>
                </form>
            </div>
        }

        <h3 class="h5 mt-4">Existing Channels</h3>
        @if (!string.IsNullOrWhiteSpace(Model.Channels.ChannelListMessage))
        {
            <p class="text-muted">@Model.Channels.ChannelListMessage</p>
        }
        else if (Model.Channels.Channels.Count == 0)
        {
            <p class="text-muted">No channels found.</p>
        }
        else
        {
            <div class="d-grid gap-3">
                @foreach (var channel in Model.Channels.Channels)
                {
                    var localPercentage = channel.CapacitySats > 0
                        ? Math.Clamp(Math.Round((decimal)channel.LocalBalanceSats / channel.CapacitySats * 100m, 1), 0m, 100m)
                        : 0m;
                    var remotePercentage = Math.Max(0m, 100m - localPercentage);

                    <div class="border rounded p-3">
                        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                            <div class="flex-grow-1">
                                <div class="text-muted small mb-1">Peer</div>
                                <div class="font-monospace small text-break">@channel.RemoteNode</div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-start">
                                <span class="badge @(channel.IsActive ? "bg-success" : "bg-secondary")">
                                    @(channel.IsActive ? "Active" : "Inactive")
                                </span>
                                <span class="badge @(channel.IsPublic ? "bg-primary" : "bg-dark")">
                                    @(channel.IsPublic ? "Public" : "Private")
                                </span>
                            </div>
                        </div>

                        <div class="text-muted small mt-3 mb-1">Channel point</div>
                        <div class="font-monospace small text-break">@channel.ChannelPoint</div>

                        <div class="d-flex justify-content-between align-items-center small text-muted mt-3 mb-2">
                            <span>Local @localPercentage.ToString("0.#")%</span>
                            <span>Remote @remotePercentage.ToString("0.#")%</span>
                        </div>
                        <div class="progress" role="progressbar" aria-label="Channel balance split">
                            <div class="progress-bar bg-success" style="width: @localPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            <div class="progress-bar bg-info" style="width: @remotePercentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>

                        <div class="row row-cols-1 row-cols-md-3 g-3 mt-1">
                            <div class="col">
                                <div class="small text-muted">Capacity</div>
                                <div class="fw-semibold">@channel.CapacityDisplay</div>
                            </div>
                            <div class="col">
                                <div class="small text-muted">Local balance</div>
                                <div class="fw-semibold">@channel.LocalBalanceDisplay</div>
                            </div>
                            <div class="col">
                                <div class="small text-muted">Remote balance</div>
                                <div class="fw-semibold">@channel.RemoteBalanceDisplay</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
