@model ServerLightningManagerViewModel

<div class="sticky-header">
    <h2>Server Lightning Send</h2>
</div>

<partial name="_StatusMessage" />
<partial name="_Result" model="Model.Result" />

@if (Model.InternalCryptoCodes.Count > 1)
{
    <form asp-controller="ServerLightningManager" asp-action="Send" method="get" class="mb-4">
        <label class="form-label" for="serverCryptoCode">Internal node</label>
        <select class="form-select w-auto" id="serverCryptoCode" name="cryptoCode" onchange="this.form.submit()">
            @foreach (var cryptoCode in Model.InternalCryptoCodes)
            {
                <option value="@cryptoCode" selected="@(cryptoCode == Model.SelectedCryptoCode)">@cryptoCode</option>
            }
        </select>
    </form>
}

<div class="card">
    <div class="card-body">
        <h3 class="h5">Node Payment</h3>
        @if (Model.Send.Payment is not null)
        {
            <dl>
                <dt>Status</dt>
                <dd>@Model.Send.Payment.Status</dd>
                @if (!string.IsNullOrWhiteSpace(Model.Send.Payment.TotalAmountDisplay))
                {
                    <dt>Total sent</dt>
                    <dd>@Model.Send.Payment.TotalAmountDisplay</dd>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Send.Payment.FeeAmountDisplay))
                {
                    <dt>Fee</dt>
                    <dd>@Model.Send.Payment.FeeAmountDisplay</dd>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Send.Payment.PaymentHash))
                {
                    <dt>Payment hash</dt>
                    <dd><code>@Model.Send.Payment.PaymentHash</code></dd>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Send.Payment.Preimage))
                {
                    <dt>Preimage</dt>
                    <dd><code>@Model.Send.Payment.Preimage</code></dd>
                }
            </dl>
            <a asp-controller="ServerLightningManager"
               asp-action="Send"
               asp-route-cryptoCode="@Model.SelectedCryptoCode"
               class="btn btn-secondary">
                Send another payment
            </a>
        }
        else if (Model.Send.Preview is not null)
        {
            <dl>
                <dt>Amount</dt>
                <dd>@Model.Send.Preview.AmountDisplay</dd>
                <dt>Description</dt>
                <dd>@Model.Send.Preview.Description</dd>
                <dt>Maximum fee</dt>
                <dd>@Model.Send.Preview.MaxFeeDisplay</dd>
                <dt>Payee</dt>
                <dd><code>@Model.Send.Preview.Payee</code></dd>
                <dt>Payment hash</dt>
                <dd><code>@Model.Send.Preview.PaymentHash</code></dd>
                <dt>Expires</dt>
                <dd>@Model.Send.Preview.ExpiresAt.ToString("u")</dd>
            </dl>
            <form asp-controller="ServerLightningManager" asp-action="ExecuteSend" method="post" class="d-inline">
                <input type="hidden" name="cryptoCode" value="@Model.SelectedCryptoCode" />
                <input type="hidden" name="bolt11" value="@Model.Send.Preview.Bolt11" />
                <input type="hidden" name="maxFeeSats" value="@Model.Send.Preview.MaxFeeSats" />
                <button type="submit" class="btn btn-primary">Send payment</button>
            </form>
            <a asp-controller="ServerLightningManager"
               asp-action="Send"
               asp-route-cryptoCode="@Model.SelectedCryptoCode"
               class="btn btn-secondary ms-2">
                Edit invoice
            </a>
        }
        else
        {
            <form asp-controller="ServerLightningManager" asp-action="PreviewSend" method="post">
                <input type="hidden" name="cryptoCode" value="@Model.SelectedCryptoCode" />
                <div class="mb-3">
                    <label class="form-label" for="serverBolt11">BOLT11 invoice</label>
                    <textarea class="form-control font-monospace" id="serverBolt11" name="bolt11" rows="5" placeholder="lnbc...">@Model.Send.Bolt11</textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="serverMaxFeeSats">Maximum fee sats</label>
                    <input class="form-control" id="serverMaxFeeSats" name="maxFeeSats" value="@(Model.Send.MaxFeeSats ?? Model.Send.DefaultMaxFeeSats)" inputmode="numeric" />
                </div>
                <button type="submit" class="btn btn-primary" disabled="@(!Model.Send.IsConfigured || !Model.Send.Capabilities.CanPayBolt11)">Preview payment</button>
            </form>
        }
    </div>
</div>
