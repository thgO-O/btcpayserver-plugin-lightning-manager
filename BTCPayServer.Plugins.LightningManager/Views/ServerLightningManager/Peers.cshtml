@model ServerLightningManagerViewModel

<div class="sticky-header">
    <h2>Server Lightning Peers</h2>
</div>

<partial name="_StatusMessage" />
<partial name="_Result" model="Model.Result" />

@if (Model.InternalCryptoCodes.Count > 1)
{
    <form asp-controller="ServerLightningManager" asp-action="Peers" method="get" class="mb-4">
        <label class="form-label" for="serverCryptoCode">Internal node</label>
        <select class="form-select w-auto" id="serverCryptoCode" name="cryptoCode" onchange="this.form.submit()">
            @foreach (var cryptoCode in Model.InternalCryptoCodes)
            {
                <option value="@cryptoCode" selected="@(cryptoCode == Model.SelectedCryptoCode)">@cryptoCode</option>
            }
        </select>
    </form>
}

<div class="card">
    <div class="card-body">
        <h3 class="h5">Peer Connection</h3>
        <form asp-controller="ServerLightningManager" asp-action="ConnectPeer" method="post" class="mb-4">
            <input type="hidden" name="cryptoCode" value="@Model.SelectedCryptoCode" />
            <div class="mb-3">
                <label class="form-label" for="serverNodeUri">Node URI</label>
                <input class="form-control" id="serverNodeUri" name="nodeUri" value="@Model.Peers.NodeUri" placeholder="pubkey@host:9735" />
                <div class="form-text">Use the format <code>pubkey@host[:port]</code>.</div>
            </div>
            <button type="submit" class="btn btn-primary" disabled="@(!Model.Peers.IsConfigured || !Model.Peers.Capabilities.CanConnectPeer)">Connect peer</button>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Peers.PeerListMessage))
        {
            <p class="text-muted mb-0">@Model.Peers.PeerListMessage</p>
        }
    </div>
</div>
