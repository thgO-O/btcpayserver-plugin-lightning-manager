@model FundViewModel
@{
    Layout = "_LayoutWizard";
    ViewData.SetTitle("Add funds to node");
}

@section PageHeadContent
{
    <link href="~/main/qrcode.css" rel="stylesheet" asp-append-version="true" />
}

@section Navbar
{
    <a asp-action="Overview" asp-route-storeId="@Model.StoreId" asp-route-cryptoCode="@Model.CryptoCode"
       id="CancelWizard" class="cancel" aria-label="Back to Lightning Manager overview">
        <vc:icon symbol="cross" />
    </a>
}

<header class="text-center">
    <h1 class="mb-4">@ViewData["Title"]</h1>
</header>

<partial name="LightningManager/_InternalNodeNotice" model="Model" />

@if (!Model.IsConfigured)
{
    <div class="alert alert-warning">@Model.ConfigurationMessage</div>
}
else if (!Model.Capabilities.CanGetDepositAddress)
{
    <p class="text-center">Use your Lightning wallet or provider's deposit tools. This backend does not expose an on-chain deposit address through Lightning Manager.</p>
}
else
{
    @if (Model.Error is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }
    <div class="payment-box">
        <p class="mb-1"><strong>@Model.BackendDisplayName</strong></p>
        <p class="text-muted mb-4">Send Bitcoin on <strong>@Model.NetworkName</strong> to this node's on-chain wallet.</p>
        @if (Model.Address is not null)
        {
            <div class="qr-container">
                <vc:qr-code data="@Model.BitcoinUri" />
            </div>
            <dl class="my-3 text-start">
                <dt class="form-label fw-normal">Bitcoin address</dt>
                <dd id="node-deposit-address" class="form-control font-monospace text-break mb-0">@Model.Address</dd>
            </dl>
            <button type="button" class="btn btn-secondary w-100 mb-3" data-clipboard-target="#node-deposit-address">Copy address</button>
            <a href="@Model.BitcoinUri" class="btn btn-outline-secondary w-100">Open in wallet</a>
        }
        else
        {
            <form asp-controller="LightningManager" asp-action="GenerateDepositAddress" asp-route-storeId="@Model.StoreId" asp-route-cryptoCode="@Model.CryptoCode" method="post">
                <button type="submit" class="btn btn-primary w-100">@(Model.Error is null ? "Generate deposit address" : "Try again")</button>
            </form>
        }
        <p class="text-muted small mt-3 mb-4">This is an on-chain deposit, not a Lightning payment. Your store's Bitcoin wallet is separate.</p>
        <details class="text-start">
            <summary>How do I use these funds?</summary>
            <p class="text-muted small mt-3 mb-2">Wait for your deposit to confirm, then check the node's on-chain balance. Keep enough funds for network fees and any reserve required by the node.</p>
            @if (Model.Capabilities.CanOpenChannel)
            {
                <p class="text-muted small mb-2">Open a channel and wait for it to become active before paying over Lightning.</p>
                <a asp-action="Channels" asp-route-storeId="@Model.StoreId" asp-route-cryptoCode="@Model.CryptoCode">Open a channel</a>
            }
        </details>
    </div>
}
