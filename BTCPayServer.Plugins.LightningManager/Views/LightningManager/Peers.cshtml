@model PeersViewModel

<div class="sticky-header">
    <h2>Connect Lightning Peer</h2>
</div>

<partial name="_StatusMessage" />

@if (!Model.IsConfigured)
{
    <div class="alert alert-warning">@Model.ConfigurationMessage</div>
}
else if (!Model.Capabilities.CanConnectPeer)
{
    <div class="alert alert-info">Peer connections are not supported by this Lightning backend.</div>
}
else
{
    <div class="card">
        <div class="card-body">
            <h3 class="h5">Peer Connection</h3>
            <form asp-controller="LightningManager"
                  asp-action="ConnectPeer"
                  asp-route-storeId="@Model.StoreId"
                  asp-route-cryptoCode="@Model.CryptoCode"
                  method="post">
                <div class="mb-3">
                    <label class="form-label" for="nodeUri">Node URI</label>
                    <input class="form-control" id="nodeUri" name="nodeUri" placeholder="pubkey@host:9735" required />
                    <div class="form-text">Use the format <code>pubkey@host[:port]</code>.</div>
                </div>
                <button type="submit" class="btn btn-primary">Connect peer</button>
            </form>
        </div>
    </div>
}
