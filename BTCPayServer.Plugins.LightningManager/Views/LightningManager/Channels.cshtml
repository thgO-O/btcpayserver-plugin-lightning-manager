@model ChannelsViewModel

@section PageFootContent
{
    <script>
        const openChannelForm = document.getElementById('open-channel-form')
        openChannelForm?.addEventListener('submit', event => {
            if (openChannelForm.dataset.submitting) {
                event.preventDefault()
                return
            }

            openChannelForm.dataset.submitting = 'true'
            openChannelForm.querySelector('button[type="submit"]')?.setAttribute('disabled', 'disabled')
        })
    </script>
}

<div class="sticky-header">
    <h2>Channels</h2>
    @if (Model.IsConfigured && Model.Capabilities.CanConnectPeer)
    {
        <a asp-action="Peers" asp-route-storeId="@Model.StoreId" asp-route-cryptoCode="@Model.CryptoCode" class="btn btn-secondary">Manage peers</a>
    }
</div>

<partial name="LightningManager/_InternalNodeNotice" model="Model" />

@if (!Model.IsConfigured)
{
    <div class="alert alert-warning">@Model.ConfigurationMessage</div>
}
else if (!Model.Capabilities.CanOpenChannel && !Model.Capabilities.CanListChannels)
{
    <div class="alert alert-info">Channel management is not supported by this Lightning backend.</div>
}

@if (Model.Result is not null)
{
    <div class="alert @(Model.Result.IsSuccess ? "alert-success" : "alert-danger")" role="alert">
        @Model.Result.Message
        @if (Model.Result.InsufficientOnchainBalance && Model.IsConfigured && Model.Capabilities.CanGetDepositAddress)
        {
            <form asp-action="GenerateDepositAddress" asp-route-storeId="@Model.StoreId" asp-route-cryptoCode="@Model.CryptoCode" method="post" class="mt-3">
                <button type="submit" class="btn btn-secondary">Add funds to node</button>
            </form>
        }
    </div>
}

@if (Model.Capabilities.CanOpenChannel)
{
    @if (Model.Preview is not null)
    {
        <div class="card">
            <div class="card-body">
                <h3 class="h5">Confirm Channel Open</h3>
                <p class="text-muted">The node will connect to this peer and request the channel when you confirm.</p>
                <dl>
                    <dt>Peer</dt>
                    <dd><code>@Model.Preview.NodeUri</code></dd>
                    <dt>Amount</dt>
                    <dd>@Model.Preview.ChannelAmountDisplay</dd>
                    <dt>Fee rate</dt>
                    <dd>@Model.Preview.FeeRateDisplay</dd>
                </dl>
                <form asp-controller="LightningManager"
                      asp-action="OpenChannel"
                      asp-route-storeId="@Model.StoreId"
                      asp-route-cryptoCode="@Model.CryptoCode"
                      method="post"
                      id="open-channel-form">
                    <input type="hidden" name="nodeUri" value="@Model.NodeUri" />
                    <input type="hidden" name="channelAmountSats" value="@Model.ChannelAmountSats" />
                    <input type="hidden" name="feeRateSatsPerByte" value="@Model.FeeRateSatsPerByte" />
                    <input type="hidden" name="confirmationToken" value="@Model.OpenChannelConfirmationToken" />
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">Open channel</button>
                        <a asp-controller="LightningManager"
                           asp-action="Channels"
                           asp-route-storeId="@Model.StoreId"
                           asp-route-cryptoCode="@Model.CryptoCode"
                           class="btn btn-secondary">
                            Start over
                        </a>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <h3 class="h5">Open Channel</h3>
                <form asp-controller="LightningManager"
                      asp-action="PreviewChannel"
                      asp-route-storeId="@Model.StoreId"
                      asp-route-cryptoCode="@Model.CryptoCode"
                      method="post">
                    <div class="mb-3">
                        <label class="form-label" for="channelNodeUri">Node URI</label>
                        <input class="form-control" id="channelNodeUri" name="nodeUri" value="@Model.NodeUri" placeholder="pubkey@host:9735" required />
                        <div class="form-text">The node connects automatically when you confirm the channel opening.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="channelAmountSats">Channel amount (sats)</label>
                        <input class="form-control" id="channelAmountSats" name="channelAmountSats" value="@Model.ChannelAmountSats" type="number" inputmode="numeric" min="1" step="1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="feeRateSatsPerByte">Fee rate (sat/vB)</label>
                        <input class="form-control" id="feeRateSatsPerByte" name="feeRateSatsPerByte" value="@Model.FeeRateSatsPerByte" type="number" inputmode="numeric" min="1" max="@int.MaxValue" step="1" />
                        <div class="form-text">Leave blank to use the default 1 sat/vB.</div>
                    </div>
                    <button type="submit" class="btn btn-primary">Preview channel open</button>
                </form>
            </div>
        </div>
    }
}

@if (Model.Capabilities.CanListChannels)
{
<div class="card mt-4">
    <div class="card-body">
        <h3 class="h5">Existing Channels</h3>
        @if (!string.IsNullOrWhiteSpace(Model.ChannelListMessage))
        {
            <div class="alert alert-warning" role="alert">@Model.ChannelListMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.PendingChannelListMessage))
        {
            <div class="alert alert-warning" role="alert">@Model.PendingChannelListMessage</div>
        }
        @if (Model.Channels.Count == 0 && Model.ChannelListMessage is null && Model.PendingChannelListMessage is null)
        {
            <p class="text-muted">No channels found.</p>
        }
        @if (Model.Channels.Count > 0)
        {
            <div class="d-grid gap-3">
                @foreach (var channel in Model.Channels)
                {
                    var localPercentage = channel.CapacitySats > 0
                        ? Math.Clamp(Math.Round(channel.LocalBalanceSats / channel.CapacitySats * 100m, 1), 0m, 100m)
                        : 0m;
                    var remotePercentage = channel.CapacitySats > 0
                        ? 100m - localPercentage
                        : 0m;
                    var statusBadgeClass = channel.IsPending is true
                        ? "bg-warning text-dark"
                        : channel.IsActive
                            ? "bg-success"
                            : "bg-secondary";

                    <div class="border rounded p-3">
                        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                            <div class="flex-grow-1">
                                <div class="text-muted small mb-1">Peer</div>
                                <div class="font-monospace small text-break">@channel.RemoteNode</div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-start">
                                <span class="badge @statusBadgeClass">
                                    @channel.Status
                                </span>
                                @if (channel.IsPublic is { } isPublic)
                                {
                                    <span class="badge @(isPublic ? "bg-primary" : "bg-dark")">
                                        @(isPublic ? "Public" : "Private")
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="text-muted small mt-3 mb-1">Channel point</div>
                        <div class="font-monospace small text-break">@(channel.ChannelPoint ?? (channel.IsPending is true ? "Pending" : "Unavailable"))</div>

                        @if (channel.IsPending is true)
                        {
                            <p class="text-muted small mt-3 mb-0">Waiting for the funding transaction to confirm. This channel cannot be used for payments yet.</p>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between align-items-center small text-muted mt-3 mb-2">
                                <span>Local @localPercentage.ToString("0.#")%</span>
                                <span>Remote @remotePercentage.ToString("0.#")%</span>
                            </div>
                            <div class="progress"
                                 role="progressbar"
                                 aria-label="Local channel balance percentage"
                                 aria-valuenow="@localPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                                <div class="progress-bar bg-success" style="width: @localPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                <div class="progress-bar bg-info" style="width: @remotePercentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                        }
                        <div class="row row-cols-1 row-cols-md-3 g-3 mt-1">
                            <div class="col">
                                <div class="small text-muted">Capacity</div>
                                <div class="fw-semibold">@channel.CapacityDisplay</div>
                            </div>
                            @if (channel.IsPending is not true)
                            {
                                <div class="col">
                                    <div class="small text-muted">Local balance</div>
                                    <div class="fw-semibold">@channel.LocalBalanceDisplay</div>
                                </div>
                                <div class="col">
                                    <div class="small text-muted">Remote balance</div>
                                    <div class="fw-semibold">@channel.RemoteBalanceDisplay</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
}
