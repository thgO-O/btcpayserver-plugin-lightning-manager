@model OverviewViewModel
@{
    var cards = new[]
    {
        (Title: "Summary", Rows: Model.SummaryRows, EmptyMessage: "No node summary is available."),
        (Title: "Offchain Balance", Rows: Model.OffchainBalanceRows, EmptyMessage: "No offchain balances are available."),
        (Title: "Onchain Balance", Rows: Model.OnchainBalanceRows, EmptyMessage: "No onchain balances are available.")
    };
    var capabilityItems = new[]
    {
        (Label: "Info", Available: Model.Capabilities.CanGetInfo),
        (Label: "Balance", Available: Model.Capabilities.CanGetBalance),
        (Label: "Pay BOLT11", Available: Model.Capabilities.CanPayBolt11),
        (Label: "Amountless BOLT11", Available: Model.Capabilities.CanPayAmountless),
        (Label: "Set Max Fee", Available: Model.Capabilities.CanSetMaxFee),
        (Label: "Connect Peer", Available: Model.Capabilities.CanConnectPeer),
        (Label: "Open Channel", Available: Model.Capabilities.CanOpenChannel),
        (Label: "List Channels", Available: Model.Capabilities.CanListChannels)
    };
}

<div class="sticky-header">
    <h2>@Model.CryptoCode Lightning Manager</h2>
</div>

<partial name="LightningManager/_InternalNodeNotice" model="Model" />

@if (!Model.IsConfigured)
{
    <div class="alert alert-warning">@Model.ConfigurationMessage</div>
}
else
{
    @foreach (var notice in Model.Notices)
    {
        <div class="alert alert-info">@notice</div>
    }
    @foreach (var warning in Model.Warnings)
    {
        <div class="alert alert-warning" role="alert">@warning</div>
    }

    <div class="mb-4">
        <h3 class="h5">Capabilities</h3>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var item in capabilityItems)
            {
                <span class="badge @(item.Available ? "bg-success" : "bg-secondary")">
                    <span aria-hidden="true">@(item.Available ? "✓" : "×")</span>
                    @item.Label<span class="visually-hidden"> @(item.Available ? "available" : "unavailable")</span>
                </span>
            }
        </div>
    </div>

    <div class="row g-4">
        @foreach (var card in cards)
        {
            <div class="col-xl-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h5">@card.Title</h3>
                        @if (card.Rows.Count == 0)
                        {
                            <p class="text-muted mb-0">@card.EmptyMessage</p>
                        }
                        else
                        {
                            <dl class="mb-0">
                                @foreach (var row in card.Rows)
                                {
                                    <dt>@row.Label</dt>
                                    <dd>@row.Value</dd>
                                }
                            </dl>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.NodeUris.Count > 0)
    {
        <div class="card mt-4">
            <div class="card-body">
                <h3 class="h5">Node URIs</h3>
                <ul class="mb-0">
                    @foreach (var nodeUri in Model.NodeUris)
                    {
                        <li><code>@nodeUri</code></li>
                    }
                </ul>
            </div>
        </div>
    }
}
