@model SendViewModel
@{
    Layout = "_LayoutWizard";
    ViewData.SetTitle($"Pay {Model.CryptoCode}");
    var cancelUrl = Url.Action("Overview", "LightningManager", new { storeId = Model.StoreId, cryptoCode = Model.CryptoCode });
}

@section PageHeadContent
{
    <style>
        .lw-send-summary {
            display: grid;
            gap: 1.5rem;
        }

        .lw-send-hero {
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--btcpay-body-border-light, var(--bs-border-color));
            text-align: center;
        }

        .lw-send-hero-label {
            display: block;
            margin-bottom: .5rem;
            font-size: .8rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--bs-secondary-color);
        }

        .lw-send-hero-value {
            margin: 0;
            font-size: clamp(1.8rem, 4vw, 2.4rem);
            font-weight: 700;
            line-height: 1.1;
        }

        .lw-send-details {
            display: grid;
            gap: 1rem;
        }

        .lw-send-detail {
            display: grid;
            grid-template-columns: minmax(7rem, 9rem) minmax(0, 1fr);
            gap: 1rem;
            align-items: start;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--btcpay-body-border-light, var(--bs-border-color));
        }

        .lw-send-detail:last-child {
            border-bottom: 0;
            padding-bottom: 0;
        }

        .lw-send-detail-label {
            font-size: .8rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--bs-secondary-color);
        }

        .lw-send-detail-value {
            min-width: 0;
            margin: 0;
            font-size: 1rem;
            line-height: 1.45;
            word-break: break-word;
        }

        .lw-send-detail-value code {
            font-size: .95em;
            white-space: normal;
        }

        @@media (max-width: 575.98px) {
            .lw-send-detail {
                grid-template-columns: 1fr;
                gap: .35rem;
            }
        }
    </style>
}

@section Navbar {
    <a href="@Url.EnsureLocal(cancelUrl, Context.Request)" id="CancelWizard" class="cancel">
        <vc:icon symbol="cross" />
    </a>
}

<header class="text-center">
    <h1>@ViewData["Title"]</h1>
</header>

<partial name="_StatusMessage" />

@if (!Model.IsConfigured)
{
    <div class="alert alert-warning">@Model.ConfigurationMessage</div>
}

@if (Model.Result is not null)
{
    <div class="alert @(Model.Result.IsSuccess ? "alert-success" : "alert-danger")">
        <div>@Model.Result.Message</div>
        @if (!string.IsNullOrWhiteSpace(Model.Result.Detail))
        {
            <div class="small text-muted mt-1">@Model.Result.Detail</div>
        }
    </div>
}

@foreach (var notice in Model.Notices)
{
    <div class="alert alert-info">@notice</div>
}

@if (Model.Payment is not null)
{
    <div class="payment-box">
        <h2 class="h4 mb-4 text-center">Payment Result</h2>
        <div class="lw-send-summary">
            @if (!string.IsNullOrWhiteSpace(Model.Payment.TotalAmountDisplay))
            {
                <div class="lw-send-hero">
                    <span class="lw-send-hero-label">Total paid</span>
                    <p class="lw-send-hero-value">@Model.Payment.TotalAmountDisplay</p>
                </div>
            }
            <div class="lw-send-details">
                <div class="lw-send-detail">
                    <div class="lw-send-detail-label">Status</div>
                    <div class="lw-send-detail-value">@Model.Payment.Status</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Payment.FeeAmountDisplay))
                {
                    <div class="lw-send-detail">
                        <div class="lw-send-detail-label">Fee</div>
                        <div class="lw-send-detail-value">@Model.Payment.FeeAmountDisplay</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Payment.PaymentHash))
                {
                    <div class="lw-send-detail">
                        <div class="lw-send-detail-label">Payment hash</div>
                        <div class="lw-send-detail-value"><code>@Model.Payment.PaymentHash</code></div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Payment.Preimage))
                {
                    <div class="lw-send-detail">
                        <div class="lw-send-detail-label">Preimage</div>
                        <div class="lw-send-detail-value"><code>@Model.Payment.Preimage</code></div>
                    </div>
                }
            </div>
        </div>
        <div class="mt-4">
            <a asp-controller="LightningManager"
               asp-action="Send"
               asp-route-storeId="@Model.StoreId"
               asp-route-cryptoCode="@Model.CryptoCode"
               class="btn btn-primary w-100">
                Pay another invoice
            </a>
        </div>
    </div>
}
else if (Model.Preview is not null)
{
    <div class="payment-box">
        <h2 class="h4 mb-4 text-center">Confirm Payment</h2>
        <div class="lw-send-summary">
            <div class="lw-send-hero">
                <span class="lw-send-hero-label">Amount</span>
                <p class="lw-send-hero-value">@Model.Preview.AmountDisplay</p>
            </div>
            <div class="lw-send-details">
                <div class="lw-send-detail">
                    <div class="lw-send-detail-label">Description</div>
                    <div class="lw-send-detail-value">@Model.Preview.Description</div>
                </div>
                <div class="lw-send-detail">
                    <div class="lw-send-detail-label">Maximum fee</div>
                    <div class="lw-send-detail-value">@Model.Preview.MaxFeeDisplay</div>
                </div>
                <div class="lw-send-detail">
                    <div class="lw-send-detail-label">Payee</div>
                    <div class="lw-send-detail-value"><code>@Model.Preview.Payee</code></div>
                </div>
                <div class="lw-send-detail">
                    <div class="lw-send-detail-label">Payment hash</div>
                    <div class="lw-send-detail-value"><code>@Model.Preview.PaymentHash</code></div>
                </div>
                <div class="lw-send-detail">
                    <div class="lw-send-detail-label">Expires</div>
                    <div class="lw-send-detail-value">@Model.Preview.ExpiresAt.ToString("u")</div>
                </div>
            </div>
        </div>
        <form asp-controller="LightningManager"
              asp-action="ExecuteSend"
              asp-route-storeId="@Model.StoreId"
              asp-route-cryptoCode="@Model.CryptoCode"
              method="post"
              class="mt-4">
            <input type="hidden" name="bolt11" value="@Model.Preview.Bolt11" />
            <input type="hidden" name="maxFeeSats" value="@Model.Preview.MaxFeeSats" />
            <div class="d-grid gap-3">
                <button type="submit" class="btn btn-primary">Pay invoice</button>
                <a asp-controller="LightningManager"
                   asp-action="Send"
                   asp-route-storeId="@Model.StoreId"
                   asp-route-cryptoCode="@Model.CryptoCode"
                   class="btn btn-secondary">
                    Edit invoice
                </a>
            </div>
        </form>
    </div>
}
else
{
    <form asp-controller="LightningManager"
          asp-action="PreviewSend"
          asp-route-storeId="@Model.StoreId"
          asp-route-cryptoCode="@Model.CryptoCode"
          method="post"
          class="my-5">
        <div class="payment-box">
            <div class="form-group mb-0">
                <label class="form-label" for="bolt11">BOLT11 invoice</label>
                <textarea class="form-control font-monospace" id="bolt11" name="bolt11" rows="6" placeholder="lnbc...">@Model.Bolt11</textarea>
                <div class="form-text">Paste the full invoice exactly as received.</div>
            </div>
            <div class="form-group mt-3 mb-0">
                <label class="form-label" for="maxFeeSats">Maximum fee sats</label>
                <input class="form-control" id="maxFeeSats" name="maxFeeSats" value="@(Model.MaxFeeSats ?? Model.DefaultMaxFeeSats)" inputmode="numeric" />
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary w-100" disabled="@(!Model.IsConfigured || !Model.Capabilities.CanPayBolt11)">Preview payment</button>
            </div>
        </div>
    </form>
}
