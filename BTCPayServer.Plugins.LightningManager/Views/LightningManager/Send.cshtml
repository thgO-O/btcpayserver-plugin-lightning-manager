@model SendViewModel
@{
    Layout = "_LayoutWizard";
    ViewData.SetTitle($"Pay {Model.CryptoCode}");
}

@section Navbar {
    <a asp-controller="LightningManager"
       asp-action="Overview"
       asp-route-storeId="@Model.StoreId"
       asp-route-cryptoCode="@Model.CryptoCode"
       id="CancelWizard"
       aria-label="Back to Lightning Manager overview"
       class="cancel">
        <vc:icon symbol="cross" />
    </a>
}

@section PageFootContent
{
    <script>
        const executePaymentForm = document.getElementById('execute-payment-form')
        executePaymentForm?.addEventListener('submit', event => {
            if (executePaymentForm.dataset.submitting) {
                event.preventDefault()
                return
            }

            executePaymentForm.dataset.submitting = 'true'
            executePaymentForm.querySelector('button[type="submit"]')?.setAttribute('disabled', 'disabled')
        })
    </script>
}

<header class="text-center">
    <h1>@ViewData["Title"]</h1>
</header>

@if (!Model.IsConfigured)
{
    <div class="alert alert-warning">@Model.ConfigurationMessage</div>
}

@if (Model.Result is not null)
{
    <div class="alert @(Model.Result.IsSuccess ? "alert-success" : "alert-danger")" role="alert">
        @Model.Result.Message
    </div>
}

@if (Model.Payment is not null)
{
    <div class="payment-box">
        <h2 class="h4 mb-4 text-center">Payment Result</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Payment.TotalAmountDisplay))
        {
            <div class="text-center border-bottom pb-4 mb-4">
                <div class="small fw-semibold text-uppercase text-muted mb-2">Total paid</div>
                <p class="h2 mb-0">@Model.Payment.TotalAmountDisplay</p>
            </div>
        }
        <dl class="row mb-0">
            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">@Model.Payment.Status</dd>
            @if (!string.IsNullOrWhiteSpace(Model.Payment.FeeAmountDisplay))
            {
                <dt class="col-sm-4">Fee</dt>
                <dd class="col-sm-8">@Model.Payment.FeeAmountDisplay</dd>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Payment.PaymentHash))
            {
                <dt class="col-sm-4">Payment hash</dt>
                <dd class="col-sm-8"><code class="text-break">@Model.Payment.PaymentHash</code></dd>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Payment.Preimage))
            {
                <dt class="col-sm-4">Preimage</dt>
                <dd class="col-sm-8"><code class="text-break">@Model.Payment.Preimage</code></dd>
            }
        </dl>
        <div class="mt-4">
            <a asp-controller="LightningManager"
               asp-action="Send"
               asp-route-storeId="@Model.StoreId"
               asp-route-cryptoCode="@Model.CryptoCode"
               class="btn btn-primary w-100">
                Pay another invoice
            </a>
        </div>
    </div>
}
else if (Model.Preview is not null)
{
    <div class="payment-box">
        <h2 class="h4 mb-4 text-center">Confirm Payment</h2>
        <div class="text-center border-bottom pb-4 mb-4">
            <div class="small fw-semibold text-uppercase text-muted mb-2">Amount</div>
            <p class="h2 mb-0">@Model.Preview.AmountDisplay</p>
        </div>
        <dl class="row mb-0">
            <dt class="col-sm-4">Description</dt>
            <dd class="col-sm-8 text-break">@Model.Preview.Description</dd>
            @if (!Model.Preview.UsesBackendFeePolicy)
            {
                <dt class="col-sm-4">Maximum fee</dt>
                <dd class="col-sm-8">@Model.Preview.MaxFeeDisplay</dd>
            }
            <dt class="col-sm-4">Payee</dt>
            <dd class="col-sm-8"><code class="text-break">@Model.Preview.Payee</code></dd>
            <dt class="col-sm-4">Payment hash</dt>
            <dd class="col-sm-8"><code class="text-break">@Model.Preview.PaymentHash</code></dd>
            <dt class="col-sm-4">Expires</dt>
            <dd class="col-sm-8">@Model.Preview.ExpiresAt.ToString("u")</dd>
        </dl>
        <form asp-controller="LightningManager"
              asp-action="ExecuteSend"
              asp-route-storeId="@Model.StoreId"
              asp-route-cryptoCode="@Model.CryptoCode"
              method="post"
              class="mt-4"
              id="execute-payment-form">
            <input type="hidden" name="bolt11" value="@Model.Preview.Bolt11" />
            <input type="hidden" name="amountSats" value="@Model.Preview.UserAmountSats" />
            <input type="hidden" name="confirmationToken" value="@Model.PaymentConfirmationToken" />
            @if (!Model.Preview.UsesBackendFeePolicy)
            {
                <input type="hidden" name="maxFeeSats" value="@Model.Preview.MaxFeeSats" />
            }
            else
            {
                <div class="alert alert-info">
                    The routing fee is controlled by this Lightning backend.
                </div>
            }
            <div class="d-grid gap-3">
                <button type="submit" class="btn btn-primary">Pay invoice</button>
                <a asp-controller="LightningManager"
                   asp-action="Send"
                   asp-route-storeId="@Model.StoreId"
                   asp-route-cryptoCode="@Model.CryptoCode"
                   class="btn btn-secondary">
                    Start over
                </a>
            </div>
        </form>
    </div>
}
else if (Model.IsConfigured && Model.Capabilities.CanPayBolt11)
{
    <form asp-controller="LightningManager"
          asp-action="PreviewSend"
          asp-route-storeId="@Model.StoreId"
          asp-route-cryptoCode="@Model.CryptoCode"
          method="post"
          class="my-5">
        <div class="payment-box">
            <div class="form-group mb-0">
                <label class="form-label" for="bolt11">BOLT11 invoice</label>
                <textarea class="form-control font-monospace" id="bolt11" name="bolt11" rows="6" placeholder="lnbc..." required>@Model.Bolt11</textarea>
                <div class="form-text">Paste the full invoice exactly as received.</div>
            </div>
            @if (Model.Capabilities.CanPayAmountless)
            {
                <div class="form-group mt-3 mb-0">
                    <label class="form-label" for="amountSats">Amount for amountless invoice (sats)</label>
                    <input class="form-control" id="amountSats" name="amountSats" value="@Model.AmountSats" type="number" inputmode="numeric" min="1" step="1" />
                    <div class="form-text">Leave blank when the invoice already specifies an amount.</div>
                </div>
            }
            @if (Model.Capabilities.CanSetMaxFee)
            {
                <div class="form-group mt-3 mb-0">
                    <label class="form-label" for="maxFeeSats">Maximum fee sats</label>
                    <input class="form-control" id="maxFeeSats" name="maxFeeSats" value="@(Model.MaxFeeSats ?? LightningManagerDefaults.SendMaxFeeSats.ToString())" type="number" inputmode="numeric" min="1" step="1" />
                </div>
            }
            else
            {
                <div class="alert alert-info mt-3 mb-0">
                    The routing fee is controlled by this Lightning backend.
                </div>
            }
            <div class="mt-4">
                <button type="submit" class="btn btn-primary w-100">Preview payment</button>
            </div>
        </div>
    </form>
}
